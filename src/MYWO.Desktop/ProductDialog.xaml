<Window x:Class="MYWO.Desktop.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj proizvod" Width="650" Height="790" MinHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" WindowStyle="None">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2B4968" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="#183D69"><TextBlock Style="{StaticResource IconText}" Text="&#xE7B8;" Foreground="#72CEFF"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Dodaj / uredi proizvod" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Unesite podatke proizvoda koji ulaze u strukturirani cjenik." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="✕" IsCancel="True"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Naziv proizvoda *"/><TextBox x:Name="NameBox" MaxLength="250"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Šifra"/><TextBox x:Name="CodeBox" MaxLength="100"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Marka"/><ComboBox x:Name="BrandBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Kategorija"/><ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Jedinica mjere (JM)"/><TextBox x:Name="UnitBox" MaxLength="30"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Cijena po jedinici"/><TextBox x:Name="UnitPriceBox"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Maloprodajna cijena (MPC) *"/><TextBox x:Name="RetailPriceBox"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Barkod"/><TextBox x:Name="BarcodeBox" MaxLength="32"/></StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SoftCardBorder}" Padding="14" Margin="0,10,0,0">
                        <StackPanel>
                            <CheckBox x:Name="SpecialSaleBox" Content="Poseban oblik prodaje" Checked="SpecialSaleBox_Changed" Unchecked="SpecialSaleBox_Changed"/>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Naziv posebnog oblika prodaje"/><TextBox x:Name="SpecialSaleNameBox" MaxLength="150"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Sidrena cijena"/><TextBox x:Name="AnchorPriceBox"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Dostupnost *"/><ComboBox x:Name="AvailabilityBox"><ComboBoxItem Content="Dostupno"/><ComboBoxItem Content="Nedostupno"/><ComboBoxItem Content="Po narudžbi"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Status"/><Border Style="{StaticResource SoftCardBorder}" Padding="10,6" Margin="0,3"><CheckBox x:Name="ActiveBox" Content="Aktivan proizvod"/></Border></StackPanel>
                    </Grid>

                    <Border Background="#0A1726" BorderBrush="#1B3855" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <TextBlock Text="MYWO provjerava obavezna polja, duplikate šifre i barkoda te ispravnost cijena prije spremanja." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Odustani" IsCancel="True"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Spremi proizvod" IsDefault="True" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
