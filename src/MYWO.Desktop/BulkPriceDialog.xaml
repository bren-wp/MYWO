<Window x:Class="MYWO.Desktop.BulkPriceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masovna promjena cijena" Width="660" Height="720" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" WindowStyle="None">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2B4968" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="#143D67"><TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" Foreground="#79D5FF"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Masovna promjena cijena" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="Odabrane stavke" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="✕" IsCancel="True"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <Border Style="{StaticResource SoftCardBorder}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Što želite promijeniti?" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Polje cijene" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    <ComboBox x:Name="TargetBox" SelectionChanged="Input_Changed">
                                        <ComboBoxItem Content="Maloprodajna cijena (MPC)" Tag="retail" IsSelected="True"/>
                                        <ComboBoxItem Content="Sidrena cijena" Tag="anchor"/>
                                        <ComboBoxItem Content="MPC + sidrena cijena" Tag="both"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Način" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    <ComboBox x:Name="ModeBox" SelectionChanged="Input_Changed">
                                        <ComboBoxItem Content="Promijeni za postotak" Tag="percent" IsSelected="True"/>
                                        <ComboBoxItem Content="Dodaj / oduzmi fiksni iznos" Tag="fixed"/>
                                        <ComboBoxItem Content="Postavi na točnu vrijednost" Tag="set"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0"><TextBlock x:Name="ValueLabel" Text="Promjena (%)" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="ValueBox" Text="5" TextChanged="Input_Changed"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Zaokruživanje" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    <ComboBox x:Name="RoundingBox" SelectionChanged="Input_Changed">
                                        <ComboBoxItem Content="0,01 €" Tag="0.01" IsSelected="True"/><ComboBoxItem Content="0,05 €" Tag="0.05"/><ComboBoxItem Content="0,10 €" Tag="0.10"/><ComboBoxItem Content="1,00 €" Tag="1.00"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SoftCardBorder}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Vrijeme primjene" FontWeight="SemiBold"/>
                            <RadioButton x:Name="ApplyNowBox" Content="Primijeni odmah" IsChecked="True" Margin="0,10,0,3" Checked="Timing_Changed"/>
                            <RadioButton x:Name="ScheduleBox" Content="Planiraj za kasnije" Margin="0,3" Checked="Timing_Changed"/>
                            <Grid x:Name="ScheduleFields" IsEnabled="False" Margin="24,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Datum" Foreground="{StaticResource MutedBrush}" FontSize="11"/><DatePicker x:Name="EffectiveDatePicker"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Vrijeme (HH:mm)" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="EffectiveTimeBox" Text="09:00"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Napomena"/><TextBox x:Name="NoteBox" MaxLength="250" ToolTip="Npr. Usklađenje s dobavljačem"/>

                    <Border Background="#091725" BorderBrush="#1C3854" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Pregled operacije" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PreviewText" Foreground="#A9C6E5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            <TextBlock Text="Svaka stvarna promjena zapisuje se u povijest cijena i audit log. Planirane promjene možete otkazati prije izvršenja." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Odustani" IsCancel="True"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Potvrdi promjenu" IsDefault="True" Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
