<Window x:Class="MYWO.Desktop.BrandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Brend" Width="560" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2B4968" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="9" Background="#533A16"><TextBlock Style="{StaticResource IconText}" Text="&#xE734;" Foreground="#FFC86B"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="Heading" Text="Brend" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Uredite naziv, opis i status brenda." Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="✕" IsCancel="True"/></Grid>
            <StackPanel Grid.Row="1"><TextBlock Text="Naziv brenda *"/><TextBox x:Name="NameBox" MaxLength="150"/><TextBlock Text="Opis" Margin="0,9,0,0"/><TextBox x:Name="DescriptionBox" MaxLength="500" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/><Border Style="{StaticResource SoftCardBorder}" Padding="10,6" Margin="0,12,0,0"><CheckBox x:Name="ActiveBox" Style="{StaticResource ToggleSwitch}" Content="Aktivan brend"/></Border></StackPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Odustani" IsCancel="True"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Spremi brend" IsDefault="True" Click="Save_Click"/></Grid>
        </Grid>
    </Border>
</Window>
