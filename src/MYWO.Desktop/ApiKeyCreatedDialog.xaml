<Window x:Class="MYWO.Desktop.ApiKeyCreatedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="570" Height="390" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" WindowStyle="None">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2B4968" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Generiraj novi API ključ" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕" IsCancel="True"/></Grid>
            <StackPanel Grid.Row="1">
                <Border Width="50" Height="50" HorizontalAlignment="Center" CornerRadius="25" Background="{StaticResource SuccessBgBrush}" BorderBrush="#1A754F" BorderThickness="1"><TextBlock Text="✓" FontSize="28" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="API ključ je uspješno generiran!" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="Spremite ključ na sigurno. Prikazuje se samo jednom i više ga nećete moći ponovno vidjeti." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="24,6"/>
                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBox x:Name="KeyBox" Grid.Column="0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"/><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="⧉" Click="Copy_Click" Margin="5,3,0,3"/></Grid>
                <Border Background="#332914" BorderBrush="#735D20" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0"><TextBlock Text="⚠ Čuvajte ovaj ključ na sigurnom mjestu. Ako ga izgubite, morate generirati novi ključ." Foreground="#FFD36A" TextWrapping="Wrap" FontSize="11"/></Border>
            </StackPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Gotovo" IsDefault="True" Click="Done_Click"/></Grid>
        </Grid>
    </Border>
</Window>
