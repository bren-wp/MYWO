<Window x:Class="MYWO.Desktop.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="280" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2B4968" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕" IsCancel="True"/></Grid>
            <StackPanel Grid.Row="1"><TextBlock Text="Naziv" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ValueBox" MaxLength="160"/></StackPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Odustani" IsCancel="True"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="U redu" IsDefault="True" Click="Ok_Click"/></Grid>
        </Grid>
    </Border>
</Window>
