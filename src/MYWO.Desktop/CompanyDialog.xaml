<Window x:Class="MYWO.Desktop.CompanyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tvrtka" Width="580" Height="520" MinWidth="430" MinHeight="360" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2B4968" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="9" Background="#173D6D"><TextBlock Style="{StaticResource IconText}" Text="&#xE731;" Foreground="#77CCFF"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tvrtka" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Svaka tvrtka ima vlastite, odvojene podatke i cjenike." Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="✕" IsCancel="True"/></Grid>
            <StackPanel Grid.Row="1"><TextBlock Text="Naziv tvrtke *"/><TextBox x:Name="NameBox" MaxLength="200"/><TextBlock Text="OIB" Margin="0,10,0,0"/><TextBox x:Name="OibBox" MaxLength="11"/><TextBlock Text="Web stranica" Margin="0,10,0,0"/><TextBox x:Name="WebsiteBox" MaxLength="300"/><Border Style="{StaticResource SoftCardBorder}" Padding="10,6" Margin="0,12,0,0"><CheckBox x:Name="ActiveBox" Content="Aktivna tvrtka"/></Border></StackPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Odustani" IsCancel="True"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Spremi tvrtku" IsDefault="True" Click="Save_Click"/></Grid>
        </Grid>
    </Border>
</Window>
