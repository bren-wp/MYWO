<Window x:Class="MYWO.Desktop.ApiKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generiraj API ključ" Width="610" Height="610" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" WindowStyle="None">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#2B4968" BorderThickness="1" CornerRadius="12">
        <Grid Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="DialogHeader_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="#173D69"><TextBlock Style="{StaticResource IconText}" Text="&#xE8D7;" Foreground="#77D6FF"/></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Generiraj novi API ključ" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Dodijelite samo dozvole koje su integraciji stvarno potrebne." Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="✕" IsCancel="True"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Naziv ključa *"/><TextBox x:Name="NameBox" MaxLength="100"/>
                    <TextBlock Text="Dozvole" Margin="0,14,0,6" FontWeight="SemiBold"/>
                    <Border Style="{StaticResource SoftCardBorder}" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="AllBox" Content="Puni pristup svim read endpointima" Checked="AllBox_Changed" Unchecked="AllBox_Changed"/>
                            <Separator Margin="0,10" Background="#203B56"/>
                            <CheckBox x:Name="CompanyBox" Content="Tvrtka — company.read" Margin="0,3"/>
                            <CheckBox x:Name="TaxonomyBox" Content="Kategorije i brendovi — taxonomy.read" Margin="0,3"/>
                            <CheckBox x:Name="ProductsBox" Content="Proizvodi — products.read" Margin="0,3"/>
                            <CheckBox x:Name="ServicesBox" Content="Usluge — services.read" Margin="0,3"/>
                            <CheckBox x:Name="CatalogBox" Content="Kombinirani katalog — catalog.read" Margin="0,3" IsChecked="True"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#0A1726" BorderBrush="#1B3855" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="Princip najmanjih ovlasti" FontWeight="SemiBold"/><TextBlock Text="Za web katalog je obično dovoljan catalog.read. Puni pristup koristite samo kada jedna integracija treba sve read endpointove." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Odustani" IsCancel="True"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Generiraj ključ" IsDefault="True" Click="Save_Click"/></Grid>
        </Grid>
    </Border>
</Window>
