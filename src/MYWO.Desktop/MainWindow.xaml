                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Dupliciraj" Click="DuplicateProduct_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Uredi" Click="EditProduct_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Aktiviraj" Click="ActivateProducts_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Deaktiviraj" Click="DeactivateProducts_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Promijeni cijene" Click="BulkProductPrices_Click"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Obriši" Click="DeleteProduct_Click"/>
                                </WrapPanel>
                            </DockPanel>

                            <!-- Product edit drawer, matching the approved reference UI -->
                            <Border x:Name="ProductDrawer" Grid.RowSpan="3" Panel.ZIndex="30" Width="422" HorizontalAlignment="Right" Visibility="Collapsed"
                                    Background="#0E1C2F" BorderBrush="#2B4D70" BorderThickness="1,0,0,0" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock x:Name="ProductDrawerTitle" Text="Dodaj proizvod" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Unesite osnovne podatke o proizvodu." Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕" Click="CloseProductDrawer_Click"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,6,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Naziv proizvoda *"/><TextBox x:Name="ProductDrawerNameBox" MaxLength="250"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Šifra"/><TextBox x:Name="ProductDrawerCodeBox" MaxLength="100"/></StackPanel>
                                            </Grid>
                                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Marka"/><ComboBox x:Name="ProductDrawerBrandBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Kategorija"/><ComboBox x:Name="ProductDrawerCategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
                                            </Grid>
                                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Jedinica mjere (JM)"/><TextBox x:Name="ProductDrawerUnitBox"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Cijena po jedinici"/><TextBox x:Name="ProductDrawerUnitPriceBox"/></StackPanel>
                                            </Grid>
                                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Maloprodajna cijena (MPC) *"/><TextBox x:Name="ProductDrawerRetailPriceBox"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Barkod"/><TextBox x:Name="ProductDrawerBarcodeBox"/></StackPanel>
                                            </Grid>
                                            <CheckBox x:Name="ProductDrawerSpecialSaleBox" Style="{StaticResource ToggleSwitch}" Content="Poseban oblik prodaje" Margin="0,10,0,2"/>
                                            <TextBlock Text="Naziv posebnog oblika prodaje"/><TextBox x:Name="ProductDrawerSpecialSaleNameBox"/>
                                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,7,0"><TextBlock Text="Sidrena cijena"/><TextBox x:Name="ProductDrawerAnchorPriceBox"/></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Dostupnost *"/><ComboBox x:Name="ProductDrawerAvailabilityBox"><ComboBoxItem Content="Dostupno"/><ComboBoxItem Content="Nedostupno"/><ComboBoxItem Content="Po narudžbi"/></ComboBox></StackPanel>
                                            </Grid>
                                            <TextBlock Text="Opis" Margin="0,10,0,0"/><TextBox x:Name="ProductDrawerDescriptionBox" Height="78" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                            <Border Style="{StaticResource SoftCardBorder}" Padding="10" Margin="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Border Width="74" Height="74" CornerRadius="10" Background="#07131F" BorderBrush="#264767" BorderThickness="1" VerticalAlignment="Top">
                                                        <Grid><TextBlock Text="▧" Foreground="#5A7593" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ProductDrawerImagePreview" Stretch="UniformToFill" Margin="3"/></Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <DockPanel><TextBlock Text="Slika proizvoda" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Style="{StaticResource GhostButton}" Content="Odaberi" Click="ChooseProductImage_Click"/><Button Style="{StaticResource GhostButton}" Content="Ukloni" Click="RemoveProductImage_Click"/></StackPanel></DockPanel>
                                                        <TextBlock x:Name="ProductDrawerImagePathText" Text="Nije odabrana" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                        <TextBlock Text="PNG, JPG, JPEG ili WEBP. Slika se kopira u lokalnu MYWO mapu." Foreground="#6E87A1" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource SoftCardBorder}" Padding="10,6" Margin="0,10,0,0"><CheckBox x:Name="ProductDrawerActiveBox" Style="{StaticResource ToggleSwitch}" Content="Aktivan proizvod"/></Border>
                                            <TextBlock Text="Aktivna stavka uključuje se u objavu kada je uključena opcija ‘samo aktivne stavke’." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Odustani" Click="CloseProductDrawer_Click"/><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Spremi proizvod" Click="SaveProductDrawer_Click"/></Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- SERVICES -->
                        <Grid x:Name="ServicesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid x:Name="ServiceFilterGrid" Grid.Row="0" Height="47">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
