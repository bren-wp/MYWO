                                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="12"><StackPanel><TextBlock Text="Akcije" Style="{StaticResource SectionTitle}"/><Button Style="{StaticResource PrimaryButton}" Content="Provjeri integritet" Click="VerifySnapshot_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Otvori datoteku" Click="OpenSnapshot_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Otvori mapu" Click="OpenSnapshotFolder_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Vrati ovu verziju" Click="RestoreSnapshot_Click"/></StackPanel></Border>
                            </Grid>
                            </Grid>
                        </ScrollViewer>

