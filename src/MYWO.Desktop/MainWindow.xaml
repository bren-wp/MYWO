                                        <ComboBoxItem Content="Svi statusi" Tag="all" IsSelected="True"/><ComboBoxItem Content="Aktivne" Tag="active"/><ComboBoxItem Content="Neaktivne" Tag="inactive"/>
                                    </ComboBox>
                                    <Border x:Name="ServiceSortBorder" Grid.Column="3" Background="#0D1D30" BorderBrush="#23415F" BorderThickness="1" CornerRadius="8" Margin="8,3,0,3" Padding="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Style="{StaticResource IconText}" Text="&#xE71C;" FontSize="14"/><TextBlock Text="Najnovije" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
                                </Grid>
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryButton}" Content="＋  Dodaj uslugu" Click="NewService_Click" Margin="0,3,8,3"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="⇧  Uvezi CSV" Click="ImportCsv_Click" Margin="0,3,8,3"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="⇩  Izvezi CSV" Click="ExportServicesCsv_Click" Margin="0,3,8,3"/>
                                    <TextBlock x:Name="ServicesCountText" Text="0 stavki" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                                </WrapPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="ServicesGrid" RowHeight="48" ColumnHeaderHeight="44" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="ServicesGrid_MouseDoubleClick">
