                                    <DataGridTemplateColumn Header="Posebna prodaja" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="#102A34" CornerRadius="10" Padding="7,3" HorizontalAlignment="Left"><TextBlock Style="{StaticResource BooleanPillText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Naziv posebnog oblika prodaje" Binding="{Binding SpecialSaleName}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Sidrena cijena" Binding="{Binding AnchorPrice, StringFormat={}{0:N2} €}" Width="115"/>
                                    <DataGridTemplateColumn Header="Status" Width="86"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusPillBorder}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource StatusPillText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Zadnja izmjena" Binding="{Binding UpdatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="135"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="2" LastChildFill="True" Margin="0,6,0,0">
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Dupliciraj" Click="DuplicateService_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Uredi" Click="EditService_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Aktiviraj" Click="ActivateServices_Click"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Deaktiviraj" Click="DeactivateServices_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Promijeni cijene" Click="BulkServicePrices_Click"/>
                                    <Button Style="{StaticResource DangerButton}" Content="Obriši" Click="DeleteService_Click"/>
                                </WrapPanel>
                            </DockPanel>

                            <Border x:Name="ServiceDrawer" Grid.RowSpan="3" Panel.ZIndex="30" Width="420" HorizontalAlignment="Right" Visibility="Collapsed"
                                    Background="#0E1C2F" BorderBrush="#2B4D70" BorderThickness="1,0,0,0" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock x:Name="ServiceDrawerTitle" Text="Uredi uslugu" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Upravljajte cijenama i oblicima prodaje." Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="✕" Click="CloseServiceDrawer_Click"/>
