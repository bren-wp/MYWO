                                            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=CategoriesGrid}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Border Background="#0B192A" BorderBrush="#1C3855" BorderThickness="0,0,0,1" Padding="8,9">
                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="▱" Foreground="#8CA5C0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ParentName}" Foreground="{StaticResource Muted2Brush}" FontSize="9"/></StackPanel>
                                                            <Border Grid.Column="2" Style="{StaticResource StatusPillBorder}" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Style="{StaticResource StatusPillText}"/></Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
