                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Background="{StaticResource BlueCardGradient}" Margin="0,0,9,0" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="10" Background="#164B87"><TextBlock Style="{StaticResource IconText}" Text="&#xE83E;" Foreground="#65D0FF" FontSize="21"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="ApiRequestCountText" Text="0" FontSize="26" FontWeight="Bold"/><TextBlock Text="API zahtjeva • zadnjih 30 dana" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Grid></Border>
                                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="{StaticResource PurpleCardGradient}" Margin="0,0,9,0" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="10" Background="#5034A5"><TextBlock Style="{StaticResource IconText}" Text="&#xE916;" Foreground="#D6C1FF" FontSize="21"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="ApiSuccessRateText" Text="100,0%" FontSize="26" FontWeight="Bold"/><TextBlock Text="Uspješnih zahtjeva" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Grid></Border>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="＋  Generiraj ključ" Click="NewApiKey_Click" Margin="0,4"/>
                            </UniformGrid>
                            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,9">
