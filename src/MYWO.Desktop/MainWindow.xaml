                                            <StackPanel><TextBlock Text="GET   /health" FontFamily="Cascadia Mono, Consolas" Foreground="#79ECAF"/><TextBlock Text="GET   /api/v1/products" FontFamily="Cascadia Mono, Consolas" Foreground="#79ECAF" Margin="0,7,0,0"/><TextBlock Text="GET   /api/v1/services" FontFamily="Cascadia Mono, Consolas" Foreground="#79ECAF" Margin="0,7,0,0"/><TextBlock Text="GET   /api/v1/catalog" FontFamily="Cascadia Mono, Consolas" Foreground="#79ECAF" Margin="0,7,0,0"/></StackPanel>
                                            <Border Grid.Column="1" Background="#07131F" BorderBrush="#173652" BorderThickness="1" CornerRadius="8" Padding="10" Margin="12,0,0,0"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#7FD4FF" TextWrapping="Wrap" Text="{}{&#10;  &quot;status&quot;: &quot;ok&quot;,&#10;  &quot;version&quot;: &quot;v1&quot;,&#10;  &quot;environment&quot;: &quot;local&quot;&#10;}"/></Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!-- HISTORY -->
