                                            <TextBlock Text="Naziv posebnog oblika prodaje"/><TextBox x:Name="ServiceDrawerSpecialSaleNameBox"/>
                                            <TextBlock Text="Napomena" Margin="0,10,0,0"/><TextBox x:Name="ServiceDrawerNotesBox" Height="90" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                                            <Border Style="{StaticResource SoftCardBorder}" Padding="10,6" Margin="0,10,0,0"><CheckBox x:Name="ServiceDrawerActiveBox" Style="{StaticResource ToggleSwitch}" Content="Aktivna usluga"/></Border>
