<Window x:Class="MYWO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MYWO – Upravljanje cjenicima"
        Width="1380" Height="950" MinWidth="880" MinHeight="600" SizeChanged="Window_SizeChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Native-feeling custom title bar -->
        <Border Grid.Row="0" Background="#0A1626" BorderBrush="#172C43" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <!-- Reference screens keep the native title strip visually empty except for window controls. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE922;" Click="Maximize_Click"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="214"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#18314B" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="SidebarLogoRow" Height="82"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="SidebarFooterRow" Height="116"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,12,14,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="#071523" BorderBrush="#214563" BorderThickness="1" VerticalAlignment="Center">
                            <Image Source="Assets/mywo-logo.png" Stretch="Uniform" Margin="2" SnapsToDevicePixels="True"/>
                        </Border>
                        <StackPanel x:Name="SidebarBrandText" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="MYWO" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="CJENICI I API" Foreground="{StaticResource Muted2Brush}" FontSize="9" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="4,2,4,10">
                            <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="dashboard" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE80F;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Pregled" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavProducts" Style="{StaticResource NavButton}" Tag="products" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE7B8;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Proizvodi" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavServices" Style="{StaticResource NavButton}" Tag="services" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Usluge" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavCategories" Style="{StaticResource NavButton}" Tag="categories" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Kategorije" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavBrands" Style="{StaticResource NavButton}" Tag="brands" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE8EC;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Brendovi" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>

                            <Border Height="1" Background="#142C44" Margin="18,9"/>

                            <Button x:Name="NavPublish" Style="{StaticResource NavButton}" Tag="publish" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE72D;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Objava" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavApi" Style="{StaticResource NavButton}" Tag="api" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE192;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="API ključevi" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="history" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Arhiva" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavPrices" Style="{StaticResource NavButton}" Tag="prices" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Promjene cijena" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>

                            <Border Height="1" Background="#142C44" Margin="18,9"/>

                            <Button x:Name="NavAudit" Style="{StaticResource NavButton}" Tag="audit" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Audit" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavCompanies" Style="{StaticResource NavButton}" Tag="companies" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE731;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Tvrtke" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                            <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="settings" Click="Nav_Click">
                                <DockPanel><TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Width="25" HorizontalAlignment="Left"/><TextBlock Text="Postavke" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="14,8,14,14">
                        <Border x:Name="SidebarPromoCard" Style="{StaticResource SoftCardBorder}" Padding="12" Height="76">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Jednostavno" FontSize="12"/>
                                    <TextBlock Text="vaši cjenici." FontSize="12"/>
                                    <TextBlock Text="Svugdje." FontSize="12"/>
                                </StackPanel>
                                <Canvas Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                                    <Rectangle Width="7" Height="18" Fill="#1C5E9B" Canvas.Left="2" Canvas.Top="20" RadiusX="2" RadiusY="2"/>
                                    <Rectangle Width="7" Height="28" Fill="#287DD0" Canvas.Left="14" Canvas.Top="10" RadiusX="2" RadiusY="2"/>
                                    <Rectangle Width="7" Height="38" Fill="#37A8FF" Canvas.Left="26" Canvas.Top="0" RadiusX="2" RadiusY="2"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SidebarVersionText" Text="MYWO" Foreground="{StaticResource Muted2Brush}" FontSize="10" Margin="5,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MainToolbarRow" Height="68"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <!-- App toolbar -->
                <Border Grid.Row="0" Background="#0A1728" BorderBrush="#18314B" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="TopbarCompanyColumn" Width="225"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="TopbarActionsColumn" Width="270"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CompanyCombo" Grid.Column="0" Width="190" Height="42" HorizontalAlignment="Left"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CompanyCombo_SelectionChanged"/>
                        <Grid x:Name="GlobalSearchContainer" Grid.Column="1" MaxWidth="520" MinWidth="180" HorizontalAlignment="Stretch" Margin="12,0">
                            <TextBox x:Name="GlobalSearchBox" Style="{StaticResource SearchBox}" Height="42" TextChanged="GlobalSearch_TextChanged"
                                     ToolTip="Pretraži proizvode, usluge, kategorije…"/>
                            <TextBlock Text="⌕  Pretraži proizvode, usluge, kategorije…" Foreground="{StaticResource Muted2Brush}" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=GlobalSearchBox}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border x:Name="SearchShortcutBadge" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Background="#142841" BorderBrush="#264665" BorderThickness="1" CornerRadius="6" Padding="7,3" IsHitTestVisible="False">
                                <TextBlock Text="Ctrl + K" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="NotificationButton" Style="{StaticResource SecondaryButton}" Width="42" Height="42" Padding="0" ToolTip="Obavijesti" Click="NotificationButton_Click">
                                <Grid><TextBlock Style="{StaticResource IconText}" Text="&#xE7ED;"/><Border x:Name="NotificationBadge" Background="#EF4444" CornerRadius="8" MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" Padding="3,0"><TextBlock x:Name="NotificationCountText" Text="0" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
                            </Button>
                            <Button x:Name="TopPublishButton" Style="{StaticResource PrimaryButton}" Width="145" Height="42" Tag="publish" Click="Nav_Click" ToolTip="Objavi cjenik">
                                <StackPanel Orientation="Horizontal"><TextBlock x:Name="TopPublishIcon" Style="{StaticResource IconText}" Text="&#xE724;" Margin="0,0,9,0"/><TextBlock x:Name="TopPublishText" Text="Objavi cjenik" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                        <Popup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=NotificationButton}" Placement="Bottom" HorizontalOffset="-310" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
                            <Border x:Name="NotificationPopupCard" Width="360" MaxHeight="440" Background="#0E1C2F" BorderBrush="#2B4D70" BorderThickness="1" CornerRadius="10" Padding="12">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                    <DockPanel><TextBlock Text="Obavijesti" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/><TextBlock x:Name="NotificationSummaryText" DockPanel.Dock="Right" Text="0 nepročitanih" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="NotificationList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SoftCardBorder}" Margin="0,0,0,7" Padding="10"><StackPanel><DockPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="{Binding CreatedAt, StringFormat={}{0:dd.MM. HH:mm}}" Foreground="{StaticResource Muted2Brush}" FontSize="9"/></DockPanel><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Content="Označi sve pročitanim" HorizontalAlignment="Stretch" Click="MarkNotificationsRead_Click"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <Grid x:Name="MainPageHost" Grid.Row="1" Margin="20,16,20,8">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PageHeaderRow" Height="64"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitle" Text="Pregled" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="PageSubtitle" Text="Kratki pregled stanja vaših cjenika." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="HeaderContextPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderDateText" Text="četvrtak, 24. travnja 2025." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" FontSize="11"/>
                            <TextBlock x:Name="HeaderCompanyText" Text="Tvrtka A" Foreground="#C3D1E3" HorizontalAlignment="Right" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- DASHBOARD -->
                        <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                                <UniformGrid x:Name="DashboardKpiGrid" Columns="6" Margin="0,2,0,12" Height="136">

                                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Background="{StaticResource GreenCardGradient}" Margin="0,0,8,0" Padding="13">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="#19684E" VerticalAlignment="Top"><TextBlock Style="{StaticResource IconText}" Text="&#xE7B8;" Foreground="#6EF0B1"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Proizvodi" FontSize="11"/><TextBlock x:Name="StatProducts" Text="0" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="StatActiveProducts" Text="0 aktivnih" Foreground="{StaticResource SuccessBrush}" FontSize="10"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Background="{StaticResource BlueCardGradient}" Margin="0,0,8,0" Padding="13">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="#164A84" VerticalAlignment="Top"><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Foreground="#63C8FF"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Usluge" FontSize="11"/><TextBlock x:Name="StatServices" Text="0" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="StatActiveServices" Text="0 aktivnih" Foreground="{StaticResource SuccessBrush}" FontSize="10"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="{StaticResource PurpleCardGradient}" Margin="0,0,8,0" Padding="13">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="#5034A5" VerticalAlignment="Top"><TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Foreground="#D2B9FF"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Kategorije" FontSize="11"/><TextBlock x:Name="StatCategories" Text="0" FontSize="24" FontWeight="Bold"/><TextBlock Text="Aktivno" Foreground="{StaticResource SuccessBrush}" FontSize="10"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource CardBorder}" Background="{StaticResource AmberCardGradient}" Margin="0,0,8,0" Padding="13">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="#6D4E1C" VerticalAlignment="Top"><TextBlock Style="{StaticResource IconText}" Text="&#xEA3A;" Foreground="#FFD26B"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Brendovi" FontSize="11"/><TextBlock x:Name="StatBrands" Text="0" FontSize="24" FontWeight="Bold"/><TextBlock Text="Aktivno" Foreground="{StaticResource SuccessBrush}" FontSize="10"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource CardBorder}" Background="{StaticResource BlueCardGradient}" Margin="0,0,8,0" Padding="13">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="#244262" VerticalAlignment="Top"><TextBlock Style="{StaticResource IconText}" Text="&#xE192;" Foreground="#D9E7F7"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="API ključevi" FontSize="11"/><TextBlock x:Name="StatApi" Text="0" FontSize="24" FontWeight="Bold"/><TextBlock Text="Aktivno" Foreground="{StaticResource SuccessBrush}" FontSize="10"/></StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="5" Style="{StaticResource CardBorder}" Margin="0" Padding="13">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="#31465D" VerticalAlignment="Top"><TextBlock Style="{StaticResource IconText}" Text="&#xE898;"/></Border>
                                            <StackPanel Grid.Column="1"><TextBlock Text="Zadnja objava" FontSize="11"/><TextBlock x:Name="LastPublishText" Text="Još nema objava" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="● Uspješno" Foreground="{StaticResource SuccessBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <Grid x:Name="DashboardMainGrid" Height="290">
                                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="DashboardChartColumn" Width="1.65*"/><ColumnDefinition x:Name="DashboardHistoryColumn" Width="1*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition x:Name="DashboardMainPrimaryRow" Height="*"/><RowDefinition x:Name="DashboardMainSecondaryRow" Height="0"/></Grid.RowDefinitions>
                                    <Border x:Name="DashboardChartCard" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,9,0" Padding="16">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0"><TextBlock Text="Promjene cijena u zadnjih 30 dana" Style="{StaticResource SectionTitle}"/><Border DockPanel.Dock="Right" Background="#11243A" BorderBrush="#24425F" BorderThickness="1" CornerRadius="7" Padding="9,5"><TextBlock Text="Zadnjih 30 dana" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Border></DockPanel>
                                            <Canvas x:Name="DashboardPriceChartCanvas" Grid.Row="1" Background="#081421" SizeChanged="PriceChartCanvas_SizeChanged" ClipToBounds="True"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="DashboardHistoryCard" Grid.Column="1" Style="{StaticResource CardBorder}" Padding="14">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <DockPanel><TextBlock Text="Povijest objava" Style="{StaticResource SectionTitle}"/><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Prikaži sve →" Tag="history" Click="Nav_Click"/></DockPanel>
                                            <DataGrid x:Name="DashboardHistoryGrid" Grid.Row="1" IsReadOnly="True" HeadersVisibility="None" BorderThickness="0" RowHeight="39" SelectionMode="Single">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM. HH:mm}}" Width="95"/>
                                                    <DataGridTextColumn Binding="{Binding FileName}" Width="*"/>
                                                    <DataGridTextColumn Binding="{Binding Format}" Width="55"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid x:Name="DashboardSummaryGrid" Margin="0,10,0,0" Height="218">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition x:Name="DashboardSummaryPrimaryRow" Height="*"/><RowDefinition x:Name="DashboardSummarySecondaryRow" Height="0"/></Grid.RowDefinitions>
                                    <Border x:Name="DashboardQuickDataCard" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Brzi podaci" Style="{StaticResource SectionTitle}"/>
                                            <DockPanel Margin="0,11,0,0"><TextBlock Text="Neaktivni proizvodi" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="QuickInactiveProductsText" Text="0" DockPanel.Dock="Right"/></DockPanel>
                                            <DockPanel Margin="0,10,0,0"><TextBlock Text="Nedavno dodane usluge" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="QuickRecentServicesText" Text="0" DockPanel.Dock="Right"/></DockPanel>
                                            <DockPanel Margin="0,10,0,0"><TextBlock Text="Promjene cijena" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="QuickPriceChangesText" Text="0" DockPanel.Dock="Right"/></DockPanel>
                                            <DockPanel Margin="0,10,0,0"><TextBlock Text="Aktivni API ključevi" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="QuickApiText" Text="0" DockPanel.Dock="Right"/></DockPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DashboardQuickActionsCard" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Brze akcije" Style="{StaticResource SectionTitle}"/>
                                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                                <Button Style="{StaticResource PrimaryButton}" Content="Objavi cjenik" Tag="publish" Click="Nav_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Dodaj proizvod" Click="NewProduct_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="Dodaj uslugu" Click="NewService_Click"/>
                                                <Button Style="{StaticResource SecondaryButton}" Content="API ključevi" Tag="api" Click="Nav_Click"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DashboardPromoCard" Grid.Column="2" Style="{StaticResource CardBorder}" Background="{StaticResource BlueCardGradient}" Padding="17">
                                        <StackPanel>
                                            <TextBlock Text="Vaši cjenici." FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="Veća mogućnost." FontSize="20" FontWeight="SemiBold" Foreground="#8DD7FF"/>
                                            <TextBlock Text="Jednostavno upravljajte, objavljujte i budite uvijek ažurni." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                            <TextBlock Text="✓ Točni podaci   ✓ Brža objava" Foreground="{StaticResource SuccessBrush}" FontSize="11" Margin="0,14,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- PRODUCTS -->
                        <Grid x:Name="ProductsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                                <Grid x:Name="ProductFilterGrid" Grid.Row="0" Height="47">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                    <TextBox x:Name="ProductSearch" Grid.Column="0" Style="{StaticResource SearchBox}" TextChanged="ProductFilter_Changed" ToolTip="Pretraži proizvode…"/>
                                    <ComboBox x:Name="ProductStatusFilter" Grid.Column="1" SelectionChanged="ProductFilter_Changed" Margin="8,3,0,3">
                                        <ComboBoxItem Content="Svi statusi" Tag="all" IsSelected="True"/><ComboBoxItem Content="Aktivni" Tag="active"/><ComboBoxItem Content="Neaktivni" Tag="inactive"/>
                                    </ComboBox>
