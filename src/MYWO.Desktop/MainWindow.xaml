                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Naziv proizvoda" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Šifra" Binding="{Binding Code}" Width="*"/>
