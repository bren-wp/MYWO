                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Background="{StaticResource GreenCardGradient}" Margin="0,0,8,0" Padding="13"><StackPanel><TextBlock Text="Ukupno povećanja" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PriceIncreaseText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#C7FFE7"/></StackPanel></Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Background="#331A25" Margin="0,0,8,0" Padding="13"><StackPanel><TextBlock Text="Ukupno smanjenja" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PriceDecreaseText" Text="0" FontSize="27" FontWeight="Bold" Foreground="#FFC6CB"/></StackPanel></Border>
