                                </Border>
                            </Grid>
                            <DataGrid Grid.Row="1" x:Name="ProductsGrid" RowHeight="47" ColumnHeaderHeight="44" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" MouseDoubleClick="ProductsGrid_MouseDoubleClick" SelectionChanged="ProductsGrid_SelectionChanged">
