                                    <Border Grid.Column="3" Style="{StaticResource CardBorder}" Background="{StaticResource AmberCardGradient}" Margin="0,0,7,0" Padding="13"><StackPanel><TextBlock Text="Lokalni API" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="PublishApiCardText" Text="Zaustavljen" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/><TextBlock Text="127.0.0.1" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="4" Style="{StaticResource CardBorder}" Background="{StaticResource GreenCardGradient}" Padding="13"><StackPanel><TextBlock Text="Integritet podataka" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="● Ispravan" FontSize="17" FontWeight="SemiBold" Foreground="#B5FFE0" Margin="0,6,0,0"/><TextBlock Text="SHA-256" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,7,0,0"/></StackPanel></Border>
