                        <Grid x:Name="CompaniesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,9"><Button Style="{StaticResource SecondaryButton}" Content="Audit" Tag="audit" Click="Nav_Click"/><Button Style="{StaticResource PrimaryButton}" Content="Tvrtke"/><Button Style="{StaticResource SecondaryButton}" Content="Postavke" Tag="settings" Click="Nav_Click"/></UniformGrid>
                            <DataGrid Grid.Row="1" x:Name="CompaniesGrid" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="CompaniesGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="OIB" Binding="{Binding Oib}" Width="*"/><DataGridTextColumn Header="Web stranica" Binding="{Binding Website}" Width="2*"/><DataGridTemplateColumn Header="Status" Width="86"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusPillBorder}" HorizontalAlignment="Left"><TextBlock Style="{StaticResource StatusPillText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
                            <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource PrimaryButton}" Content="＋ Dodaj tvrtku" Click="AddCompany_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Uredi" Click="EditCompany_Click"/></WrapPanel>
                        </Grid>

                        <!-- SETTINGS -->
                        <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,5,0">
                                <UniformGrid Columns="3" Margin="0,0,0,10"><Button Style="{StaticResource SecondaryButton}" Content="Audit" Tag="audit" Click="Nav_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Tvrtke" Tag="companies" Click="Nav_Click"/><Button Style="{StaticResource PrimaryButton}" Content="⚙  Postavke"/></UniformGrid>
                                <Grid x:Name="SettingsMainGrid" MinHeight="430">
                                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsCompaniesColumn" Width="0.82*" MinWidth="240"/><ColumnDefinition x:Name="SettingsSystemColumn" Width="1.65*" MinWidth="430"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition x:Name="SettingsPrimaryRow" Height="*"/><RowDefinition x:Name="SettingsSecondaryRow" Height="0"/></Grid.RowDefinitions>
                                    <Border x:Name="SettingsCompaniesCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0" Padding="14">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <StackPanel><TextBlock Text="Upravljanje tvrtkama" Style="{StaticResource SectionTitle}"/><TextBlock Text="Dodajte i upravljajte tvrtkama u sustavu." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                                            <Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="＋  Dodaj tvrtku" HorizontalAlignment="Stretch" Margin="0,3" Click="AddCompany_Click"/>
                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><ItemsControl x:Name="SettingsCompaniesList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SoftCardBorder}" Margin="0,0,0,9" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="7" Background="#174B88"><TextBlock Style="{StaticResource IconText}" Text="&#xE731;" Foreground="#8AD9FF"/></Border><StackPanel Margin="9,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="● Aktivno" Foreground="{StaticResource SuccessBrush}" FontSize="9"/></StackPanel></StackPanel><TextBlock DockPanel.Dock="Right" Text="⋮" FontSize="20" Foreground="{StaticResource MutedBrush}"/></DockPanel><Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Web" Foreground="{StaticResource Muted2Brush}" FontSize="9"/><TextBlock Text="{Binding Website}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="OIB" Foreground="{StaticResource Muted2Brush}" FontSize="9"/><TextBlock Text="{Binding Oib}" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="SettingsSystemCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition Height="126"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <DockPanel><StackPanel><TextBlock Text="Postavke sustava" Style="{StaticResource SectionTitle}"/><TextBlock Text="Konfigurirajte osnovne postavke aplikacije i aktivne tvrtke." Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="▣  Spremi postavke" Click="SaveSettings_Click"/></DockPanel>
                                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,5"><TextBlock Text="Naziv tvrtke" Foreground="{StaticResource MutedBrush}"/><TextBox Text="{Binding SelectedItem.Name, ElementName=CompanyCombo, Mode=OneWay}" IsReadOnly="True"/></StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,5"><TextBlock Text="Putanja za objavu (publish path)" Foreground="{StaticResource MutedBrush}"/><DockPanel><TextBox x:Name="SettingsPublishFolder"/><Button Style="{StaticResource SecondaryButton}" Content="…" Width="40" Click="ChooseSettingsFolder_Click"/></DockPanel></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,10,0"><TextBlock Text="API port" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SettingsApiPort" Text="8787"/></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,5,0,0"><TextBlock Text="Valuta" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SettingsCurrency" Text="EUR" MaxLength="3"/></StackPanel>
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource SoftCardBorder}" Margin="0,0,7,0" Padding="12"><StackPanel><TextBlock Text="Tema izgleda" FontWeight="SemiBold"/><TextBlock Text="Tamna tema prati vizualni identitet referentnih zaslona." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,9"/><Border Background="#0A6DDA" BorderBrush="#2EA2FF" BorderThickness="1" CornerRadius="8" Padding="10"><StackPanel Orientation="Horizontal"><TextBlock Text="☾" FontSize="18"/><TextBlock Text="Dark (zadano)" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Border><CheckBox x:Name="SettingsOnlyActive" Style="{StaticResource ToggleSwitch}" Content="Objavljuj samo aktivne stavke" Margin="0,11,0,0"/></StackPanel></Border>
                                                <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Margin="7,0" Padding="12"><StackPanel><TextBlock Text="Sigurnosne kopije" FontWeight="SemiBold"/><TextBlock Text="Izradite sigurnosnu kopiju podataka ili vratite sustav iz postojeće kopije." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,9"/><Button Style="{StaticResource PrimaryButton}" Content="⇩  Izradi sigurnosnu kopiju" Click="CreateBackup_Click"/><Button Style="{StaticResource SecondaryButton}" Content="⇧  Vrati iz kopije" Click="RestoreBackup_Click"/><Button Style="{StaticResource SecondaryButton}" Content="Provjeri bazu" Click="IntegrityCheck_Click"/><TextBlock x:Name="DatabasePathText" Foreground="{StaticResource Muted2Brush}" FontSize="9" TextWrapping="Wrap" Margin="3,5,3,0"/></StackPanel></Border>
                                                <Border Grid.Column="2" Style="{StaticResource SoftCardBorder}" Margin="7,0,0,0" Padding="12"><StackPanel><TextBlock Text="Obavijesti i automatizacija" FontWeight="SemiBold"/><CheckBox x:Name="SettingsInAppNotifications" Style="{StaticResource ToggleSwitch}" Content="Obavijesti u aplikaciji" Margin="0,8,0,0"/><CheckBox x:Name="SettingsAutoPublish" Style="{StaticResource ToggleSwitch}" Content="Automatska dnevna objava" Margin="0,5,0,0"/><DockPanel Margin="0,4,0,0"><TextBlock Text="Vrijeme" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBox x:Name="SettingsAutoPublishTime" DockPanel.Dock="Right" Width="82" Text="11:00"/></DockPanel><Separator Margin="0,9" Background="#23415F"/><TextBlock Text="Ažuriranja aplikacije" FontWeight="SemiBold"/><TextBlock x:Name="ReleaseModeText" Text="MYWO" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,7"/><Button Style="{StaticResource PrimaryButton}" Content="Provjeri ažuriranja" Click="CheckUpdates_Click"/></StackPanel></Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="0" Height="210">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <DockPanel Margin="14,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="Zadnje aktivnosti (Audit log)" Style="{StaticResource SectionTitle}"/><TextBlock Text="Pregled najnovijih aktivnosti u sustavu." Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Prikaži sve  →" Tag="audit" Click="Nav_Click"/></DockPanel>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding ItemsSource, ElementName=AuditGrid}" IsReadOnly="True" BorderThickness="0" RowHeight="36"><DataGrid.Columns><DataGridTextColumn Header="Vrijeme" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/><DataGridTextColumn Header="Akcija" Binding="{Binding Action}" Width="150"/><DataGridTextColumn Header="Entitet" Binding="{Binding EntityType}" Width="130"/><DataGridTextColumn Header="Detalji" Binding="{Binding Summary}" Width="*"/></DataGrid.Columns></DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- STATUS BAR -->
                <Border Grid.Row="2" Visibility="Collapsed" Background="#081421" BorderBrush="#142B43" BorderThickness="0,1,0,0">
                    <DockPanel Margin="16,0">
                        <TextBlock x:Name="StatusText" Text="Spremno" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompanyScopeText" DockPanel.Dock="Right" Foreground="{StaticResource Muted2Brush}" FontSize="10" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
