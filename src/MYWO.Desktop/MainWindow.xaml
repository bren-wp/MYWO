                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="46" Height="46" CornerRadius="9" Background="#124A88"><TextBlock Text="✂" FontSize="24" Foreground="#64D6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Usluga" FontWeight="SemiBold"/><TextBlock Text="Cjenik usluga" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource SuccessPill}" VerticalAlignment="Center"><TextBlock Text="● Aktivno" Foreground="{StaticResource SuccessBrush}" FontSize="10"/></Border>
