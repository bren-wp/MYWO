<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MYWO</AssemblyName>
    <RootNamespace>MYWO.Desktop</RootNamespace>
    <ApplicationIcon>Assets\mywo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.3</Version>
    <FileVersion>0.9.3.0</FileVersion>
    <AssemblyVersion>0.9.3.0</AssemblyVersion>
    <Authors>MYWO</Authors>
    <Product>MYWO – Upravljanje cjenicima</Product>
    <Description>Windows aplikacija za upravljanje, izvoz i objavu strukturiranih cjenika proizvoda i usluga.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>


  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\mywo.ico" />
    <Resource Include="Assets\mywo-logo.png" />
  </ItemGroup>
</Project>
